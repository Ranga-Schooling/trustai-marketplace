      "facts": [
        "a non-streaming Chat Completions result exposes choices[0].message.content and choices[0].finish_reason",
        "usage exposes prompt_tokens and completion_tokens",
        "Compound exposes ordered executed_tools and web search results with title, URL, content, and score",
        "Compound search results do not document requested URL, redirect chain, final fetch URL, or retrieval authentication context"
      ]
