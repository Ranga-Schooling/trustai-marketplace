DATABASE_URL=postgresql+psycopg2://trustai:trustai@db:5432/trustai
# For standalone local development without Docker Compose, use:
# DATABASE_URL=sqlite:///./trustai.db
JWT_SECRET=change-me
AI_PROVIDER=mock          # mock | groq | gpt | gemini
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra
# Visual Inspection is configured independently from AI_PROVIDER.
# V1 is enabled only with openai and reuses OPENAI_API_KEY.
VISUAL_INSPECTION_PROVIDER=disabled
VISUAL_INSPECTION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Abuse guardrails (D-22).
# Provider-consuming attempts allowed per user per rolling 24 hours.
MAX_ANALYSES_PER_DAY=50
# Comma-separated browser origins allowed to call the API cross-origin. The
# deployed frontend is same-origin and needs no entry; "*" restores the
# previous open behaviour.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
